generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 10.2A, checkpoint 1: identity, IAM, sessions, tokens, and audit.
// PostgreSQL canonical SQL remains physical schema authority. CHECK, trigger,
// RLS, privilege, and other PostgreSQL-only objects are intentionally not
// represented as equivalent Prisma declarations.

model Person {
  id                       Int                 @id(map: "pk_Person") @default(autoincrement()) @db.Integer
  firstName                String?             @db.Text
  firstSurname             String?             @db.Text
  secondSurname            String?             @db.Text
  legacyFullName           String?             @db.Text
  identification           String?             @db.Text
  identificationType       IdentificationType?
  normalizedIdentification String?             @db.Text
  birthDate                DateTime?           @db.Timestamp(3)
  email                    String?             @db.Text
  phoneCountryCode         String?             @db.Text
  phoneNationalNumber      String?             @db.Text
  address                  String?             @db.Text
  createdAt                DateTime            @default(now()) @db.Timestamp(3)
  updatedAt                DateTime            @updatedAt @db.Timestamp(3)
  affiliate                Affiliate?
  user                     User?

  @@unique([identificationType, normalizedIdentification], map: "BU01")
}

model Role {
  id          Int              @id(map: "pk_Role") @default(autoincrement()) @db.Integer
  name        String           @unique(map: "BU02") @db.Text
  description String?          @db.Text
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamp(3)
  updatedAt   DateTime         @updatedAt @db.Timestamp(3)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int              @id(map: "pk_Permission") @default(autoincrement()) @db.Integer
  code        String           @unique(map: "BU03") @db.Text
  name        String           @db.Text
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @db.Timestamp(3)
  updatedAt   DateTime         @updatedAt @db.Timestamp(3)
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int        @db.Integer
  permissionId Int        @db.Integer
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_RolePermission_roleId")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_RolePermission_permissionId")

  @@id([roleId, permissionId], map: "pk_RolePermission")
  @@index([permissionId], map: "BI001")
}

model User {
  id                         Int                      @id(map: "pk_User") @default(autoincrement()) @db.Integer
  fullName                   String                   @db.Text
  identification             String                   @unique(map: "BU04") @db.Text
  email                      String                   @unique(map: "BU05") @db.Text
  phone                      String?                  @db.Text
  address                    String?                  @db.Text
  passwordHash               String?                  @db.Text
  status                     UserStatus               @default(ACTIVE)
  failedLoginAttempts        Int                      @default(0) @db.Integer
  lockedAt                   DateTime?                @db.Timestamp(3)
  lastLoginAt                DateTime?                @db.Timestamp(3)
  personId                   Int                      @unique(map: "BU06") @db.Integer
  identificationType         IdentificationType?
  phoneCountryCode           String?                  @db.Text
  phoneNationalNumber        String?                  @db.Text
  subscriptionExpirationDate DateTime?                @db.Timestamp(3)
  createdAt                  DateTime                 @default(now()) @db.Timestamp(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamp(3)
  person                     Person                   @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_User_personId")
  roles                      UserRole[]
  sessions                   Session[]
  auditLogs                  AuditLog[]
  passwordResetTokens        PasswordResetToken[]
  activationTokens           AccountActivationToken[]
}

model Affiliate {
  id                       Int             @id(map: "pk_Affiliate") @default(autoincrement()) @db.Integer
  fullName                 String          @db.Text
  identification           String          @unique(map: "BU10") @db.Text
  birthDate                DateTime        @db.Timestamp(3)
  gender                   String?         @db.Text
  phone                    String?         @db.Text
  email                    String?         @unique(map: "BU11") @db.Text
  address                  String          @db.Text
  occupation               String?         @db.Text
  workplace                String?         @db.Text
  affiliateType            String?         @db.Text
  affiliationDate          DateTime        @default(now()) @db.Timestamp(3)
  status                   AffiliateStatus @default(ACTIVE)
  identificationType       IdentificationType?
  phoneCountryCode         String?         @db.Text
  phoneNationalNumber      String?         @db.Text
  personId                 Int?            @unique(map: "BU12") @db.Integer
  roleId                   Int?            @db.Integer
  createdAt                DateTime        @default(now()) @db.Timestamp(3)
  updatedAt                DateTime        @updatedAt @db.Timestamp(3)
  person                   Person?         @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_Affiliate_personId")

  @@index([roleId], map: "BI017")
}

model UserRole {
  userId Int  @db.Integer
  roleId Int  @db.Integer
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "UserRole_userId_fkey")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "UserRole_roleId_fkey")

  @@id([userId, roleId], map: "pk_UserRole")
  @@index([roleId], map: "ix_UserRole_roleId")
}

model Session {
  id               Int       @id(map: "pk_Session") @default(autoincrement()) @db.Integer
  refreshTokenHash String    @unique(map: "BU07") @db.Text
  expiresAt        DateTime  @db.Timestamp(3)
  revokedAt        DateTime? @db.Timestamp(3)
  revocationReason String?   @db.Text
  createdAt        DateTime  @default(now()) @db.Timestamp(3)
  userId           Int       @db.Integer
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_Session_userId")

  @@index([userId], map: "BI002")
  @@index([expiresAt], map: "BI003")
}

model AuditLog {
  id         Int      @id(map: "pk_AuditLog") @default(autoincrement()) @db.Integer
  action     String   @db.Text
  module     String   @db.Text
  entityType String?  @db.Text
  entityId   String?  @db.Text
  details    Json?    @db.JsonB
  ipAddress  String?  @db.Text
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  userId     Int?     @db.Integer
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_AuditLog_userId")

  @@index([userId], map: "BI004")
  @@index([action], map: "BI005")
  @@index([module], map: "BI006")
  @@index([createdAt], map: "BI007")
}

model PasswordResetToken {
  id        Int       @id(map: "pk_PasswordResetToken") @default(autoincrement()) @db.Integer
  tokenHash String    @unique(map: "BU08") @db.Text
  expiresAt DateTime  @db.Timestamp(3)
  usedAt    DateTime? @db.Timestamp(3)
  createdAt DateTime  @default(now()) @db.Timestamp(3)
  userId    Int       @db.Integer
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_PasswordResetToken_userId")

  @@index([userId], map: "BI008")
  @@index([expiresAt], map: "BI009")
}

model AccountActivationToken {
  id        Int       @id(map: "pk_AccountActivationToken") @default(autoincrement()) @db.Integer
  tokenHash String    @unique(map: "BU09") @db.Text
  expiresAt DateTime  @db.Timestamp(3)
  usedAt    DateTime? @db.Timestamp(3)
  createdAt DateTime  @default(now()) @db.Timestamp(3)
  userId    Int       @db.Integer
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_AccountActivationToken_userId")

  @@index([userId], map: "BI010")
  @@index([expiresAt], map: "BI011")
}

enum IdentificationType {
  NATIONAL
  DIMEX
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
}
