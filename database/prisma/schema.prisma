  return                   InventoryLoanReturn             @relation(fields: [returnId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checkoutAllocation       InventoryLoanCheckoutAllocation @relation(fields: [checkoutAllocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  availableEntryMovement   InventoryMovement?              @relation("ReturnDetailMovement", fields: [availableEntryMovementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([returnId, checkoutAllocationId])
  @@index([checkoutAllocationId])
  @@map("inventory_loan_return_detail")
}

model InventoryLoanShortage {
  id                   Int                             @id @default(autoincrement()) @db.Integer
  checkoutAllocationId Int                             @map("checkout_allocation_id")
  quantity             Decimal                         @db.Decimal(14, 3)
  status               String                          @db.VarChar(32)
  reason               String?                         @db.Text
  detectedAt           DateTime                        @default(now()) @map("detected_at") @db.Timestamp(3)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamp(3)
  checkoutAllocation   InventoryLoanCheckoutAllocation @relation(fields: [checkoutAllocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decisions            InventoryLoanShortageDecision[]

  @@index([checkoutAllocationId])
  @@map("inventory_loan_shortage")
}

model InventoryLoanShortageDecision {
  id                Int                   @id @default(autoincrement()) @db.Integer
  shortageId        Int                   @map("shortage_id")
  membershipId      Int                   @map("membership_id")
  boardResolutionId Int?                  @map("board_resolution_id")
  decidedByUserId   Int?                  @map("decided_by_user_id")
  commandKey        String                @unique @map("command_key") @db.VarChar(128)
  result            String                @db.VarChar(32)
  reason            String?               @db.Text
  decidedAt         DateTime              @map("decided_at") @db.Timestamp(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamp(3)
  shortage          InventoryLoanShortage @relation(fields: [shortageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership        GovernanceMembership  @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  boardResolution   BoardResolution?      @relation(fields: [boardResolutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByUser     User?                 @relation("ShortageDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([shortageId])
  @@index([membershipId])
  @@index([boardResolutionId])
  @@index([decidedByUserId])
  @@map("inventory_loan_shortage_decision")
}

model ExpenseDocumentLog {
  id                Int             @id @default(autoincrement()) @db.Integer
  expenseDocumentId Int             @map("expense_document_id")
  actorUserId       Int?            @map("actor_user_id")
  eventType         String          @map("event_type") @db.VarChar(32)
  eventAt           DateTime        @default(now()) @map("event_at") @db.Timestamp(3)
  snapshot          Json            @db.JsonB
  reason            String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  expenseDocument   ExpenseDocument @relation(fields: [expenseDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser         User?           @relation("ExpenseDocumentLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([expenseDocumentId])
  @@index([actorUserId])
  @@map("expense_document_log")
}

model Correspondence {
  id               Int                 @id @default(autoincrement()) @db.Integer
  documentRecordId Int                 @unique @map("document_record_id")
  direction        String              @db.VarChar(16)
  counterparty     String              @db.Text
  receivedOrSentAt DateTime?           @map("received_or_sent_at") @db.Timestamp(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamp(3)
  documentRecord   DocumentRecord      @relation(fields: [documentRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  logs             CorrespondenceLog[]

  @@map("correspondence")
}

model CorrespondenceLog {
  id               Int            @id @default(autoincrement()) @db.Integer
  correspondenceId Int            @map("correspondence_id")
  actorUserId      Int?           @map("actor_user_id")
  eventType        String         @map("event_type") @db.VarChar(32)
  eventAt          DateTime       @default(now()) @map("event_at") @db.Timestamp(3)
  snapshot         Json           @db.JsonB
  reason           String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser        User?          @relation("CorrespondenceLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([correspondenceId])
  @@index([actorUserId])
  @@map("correspondence_log")
}

model DocumentFolioCounter {
  seriesId     Int            @map("series_id")
  folioYear    Int            @map("folio_year")
  lastAssigned Int            @default(0) @map("last_assigned")
  series       DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([seriesId, folioYear])
  @@map("document_folio_counter")
}

model InventoryStockLotReceiptOrigin {
  id            Int                       @id @default(autoincrement()) @db.Integer
  lotId         Int                       @unique @map("lot_id")
  receiptLineId Int                       @map("receipt_line_id")
  lot           InventoryStockLot         @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiptLine   InKindDonationReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([receiptLineId])
  @@map("inventory_stock_lot_receipt_origin")
}

model InventoryUnitReceiptOrigin {
  id            Int                       @id @default(autoincrement()) @db.Integer
  unitId        Int                       @unique @map("unit_id")
  receiptLineId Int                       @map("receipt_line_id")
  unit          InventoryUnit             @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiptLine   InKindDonationReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([receiptLineId])
  @@map("inventory_unit_receipt_origin")
}
