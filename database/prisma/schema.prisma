model BoardSession {
  id            Int               @id @default(autoincrement()) @db.Integer
  termId        Int               @map("term_id")
  sessionNumber Int               @map("session_number")
  scheduledAt   DateTime?         @map("scheduled_at") @db.Timestamp(3)
  heldAt        DateTime?         @map("held_at") @db.Timestamp(3)
  status        String            @db.VarChar(32)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)
  term          GovernanceTerm    @relation(fields: [termId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  minute        BoardMinute?
  resolutions   BoardResolution[]

  @@unique([termId, sessionNumber])
  @@map("board_session")
}

model BoardMinute {
  id               Int             @id @default(autoincrement()) @db.Integer
  boardSessionId   Int             @map("board_session_id")
  documentRecordId Int?            @unique @map("document_record_id")
  legacyContent    String?         @map("legacy_content") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamp(3)
  boardSession     BoardSession    @relation(fields: [boardSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentRecord   DocumentRecord? @relation("BoardMinuteDocument", fields: [documentRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([boardSessionId])
  @@map("board_minute")
}

model BoardResolution {
  id                Int                             @id @default(autoincrement()) @db.Integer
  boardSessionId    Int                             @map("board_session_id")
  resolutionNumber  Int                             @map("resolution_number")
  title             String                          @db.Text
  content           String                          @db.Text
