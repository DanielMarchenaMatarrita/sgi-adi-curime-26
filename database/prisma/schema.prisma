generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 10.2A, checkpoint 1: identity, IAM, sessions, tokens, and audit.
// PostgreSQL canonical SQL remains physical schema authority. CHECK, trigger,
// RLS, privilege, and other PostgreSQL-only objects are intentionally not
// represented as equivalent Prisma declarations.

model Person {
  id                       Int                 @id(map: "pk_people") @default(autoincrement()) @db.Integer
  firstName                String?             @map("first_name") @db.Text
  firstSurname             String?             @map("first_surname") @db.Text
  secondSurname            String?             @map("second_surname") @db.Text
  legacyFullName           String?             @map("legacy_full_name") @db.Text
  identification           String?             @db.Text
  identificationType       IdentificationType? @map("identification_type")
  normalizedIdentification String?             @map("normalized_identification") @db.Text
  birthDate                DateTime?           @map("birth_date") @db.Timestamp(3)
  email                    String?             @db.Text
  phoneCountryCode         String?             @map("phone_country_code") @db.Text
  phoneNationalNumber      String?             @map("phone_national_number") @db.Text
  address                  String?             @db.Text
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamp(3)
  affiliate                Affiliate?
  user                     User?

  @@unique([identificationType, normalizedIdentification], map: "ux_people_person_identification_type_normalized_identification")
  @@map("people")
}

model Role {
  id          Int              @id(map: "pk_roles") @default(autoincrement()) @db.Integer
  name        String           @unique(map: "ux_roles_bu02_role") @db.Text
  description String?          @db.Text
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id(map: "pk_permissions") @default(autoincrement()) @db.Integer
  code        String           @unique(map: "ux_permissions_bu03_permission") @db.Text
  name        String           @db.Text
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id") @db.Integer
  permissionId Int        @map("permission_id") @db.Integer
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permissions_role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permissions_permission_id")

  @@id([roleId, permissionId], map: "pk_role_permissions")
  @@index([permissionId], map: "ix_role_permissions_bi001_role_permission_permission_id")
  @@map("role_permissions")
}

model User {
  id                         Int                      @id(map: "pk_users") @default(autoincrement()) @db.Integer
  fullName                   String                   @map("full_name") @db.Text
  identification             String                   @unique(map: "ux_users_bu04_user") @db.Text
  email                      String                   @unique(map: "ux_users_bu05_user") @db.Text
  phone                      String?                  @db.Text
  address                    String?                  @db.Text
  passwordHash               String?                  @map("password_hash") @db.Text
  status                     UserStatus               @default(ACTIVE)
  failedLoginAttempts        Int                      @default(0) @map("failed_login_attempts") @db.Integer
  lockedAt                   DateTime?                @map("locked_at") @db.Timestamp(3)
  lastLoginAt                DateTime?                @map("last_login_at") @db.Timestamp(3)
  personId                   Int                      @unique(map: "ux_users_bu06_user_person_id") @map("person_id") @db.Integer
  identificationType         IdentificationType?      @map("identification_type")
  phoneCountryCode           String?                  @map("phone_country_code") @db.Text
  phoneNationalNumber        String?                  @map("phone_national_number") @db.Text
  subscriptionExpirationDate DateTime?                @map("subscription_expiration_date") @db.Timestamp(3)
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamp(3)
  person                     Person                   @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_users_person_id")
  roles                      UserRole[]
  sessions                   Session[]
  auditLogs                  AuditLog[]
  passwordResetTokens        PasswordResetToken[]
  activationTokens           AccountActivationToken[]

  @@map("users")
}

model Affiliate {
  id                  Int                 @id(map: "pk_affiliates") @default(autoincrement()) @db.Integer
  fullName            String              @map("full_name") @db.Text
  identification      String              @unique(map: "ux_affiliates_bu10_affiliate") @db.Text
  birthDate           DateTime            @map("birth_date") @db.Timestamp(3)
  gender              String?             @db.Text
  phone               String?             @db.Text
  email               String?             @unique(map: "ux_affiliates_bu11_affiliate") @db.Text
  address             String              @db.Text
  occupation          String?             @db.Text
  workplace           String?             @db.Text
  affiliateType       String?             @map("affiliate_type") @db.Text
  affiliationDate     DateTime            @default(now()) @map("affiliation_date") @db.Timestamp(3)
  status              AffiliateStatus     @default(ACTIVE)
  identificationType  IdentificationType? @map("identification_type")
  phoneCountryCode    String?             @map("phone_country_code") @db.Text
  phoneNationalNumber String?             @map("phone_national_number") @db.Text
  personId            Int?                @unique(map: "ux_affiliates_bu12_affiliate_person_id") @map("person_id") @db.Integer
  roleId              Int?                @map("role_id") @db.Integer
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamp(3)
  person              Person?             @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_affiliates_person_id")

  @@index([roleId], map: "ix_affiliates_bi017_affiliate_role_id")
  @@map("affiliates")
}

model UserRole {
  userId Int  @map("user_id") @db.Integer
  roleId Int  @map("role_id") @db.Integer
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_roles_role_id")

  @@id([userId, roleId], map: "pk_user_roles")
  @@index([roleId], map: "ix_user_roles_ix_user_role_role_id_user_role_role_id")
  @@map("user_roles")
}

model Session {
  id               Int       @id(map: "pk_sessions") @default(autoincrement()) @db.Integer
  refreshTokenHash String    @unique(map: "ux_sessions_bu07_session_refresh_token_hash") @map("refresh_token_hash") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(3)
  revocationReason String?   @map("revocation_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  userId           Int       @map("user_id") @db.Integer
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sessions_user_id")

  @@index([userId], map: "ix_sessions_bi002_session_user_id")
  @@index([expiresAt], map: "ix_sessions_bi003_session_expires_at")
  @@map("sessions")
}

model AuditLog {
  id         Int      @id(map: "pk_audit_logs") @default(autoincrement()) @db.Integer
  action     String   @db.Text
  module     String   @db.Text
  entityType String?  @map("entity_type") @db.Text
  entityId   String?  @map("entity_id") @db.Text
  details    Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Text
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  userId     Int?     @map("user_id") @db.Integer
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_audit_logs_user_id")

  @@index([userId], map: "ix_audit_logs_bi004_audit_log_user_id")
  @@index([action], map: "ix_audit_logs_bi005_audit_log")
  @@index([module], map: "ix_audit_logs_bi006_audit_log")
  @@index([createdAt], map: "ix_audit_logs_bi007_audit_log_created_at")
  @@map("audit_logs")
}

model PasswordResetToken {
  id        Int       @id(map: "pk_password_reset_tokens") @default(autoincrement()) @db.Integer
  tokenHash String    @unique(map: "ux_password_reset_tokens_bu08_password_reset_token_token_hash") @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  usedAt    DateTime? @map("used_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  userId    Int       @map("user_id") @db.Integer
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_password_reset_tokens_user_id")

  @@index([userId], map: "ix_password_reset_tokens_bi008_password_reset_token_user_id")
  @@index([expiresAt], map: "ix_password_reset_tokens_bi009_password_reset_token_expires_at")
  @@map("password_reset_tokens")
}

model AccountActivationToken {
  id        Int       @id(map: "pk_account_activation_tokens") @default(autoincrement()) @db.Integer
  tokenHash String    @unique(map: "ux_account_activation_tokens_bu09_account_activation_t_786c9320") @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  usedAt    DateTime? @map("used_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  userId    Int       @map("user_id") @db.Integer
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_account_activation_tokens_user_id")

  @@index([userId], map: "ix_account_activation_tokens_bi010_account_activation_63984dfa")
  @@index([expiresAt], map: "ix_account_activation_tokens_bi011_account_activation_429afc13")
  @@map("account_activation_tokens")
}

enum IdentificationType {
  NATIONAL
  DIMEX

  @@map("identification_type")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE

  @@map("affiliate_status")
}
